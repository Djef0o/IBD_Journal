<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Données de santé : aucune sauvegarde dans le cloud de Google. Seul le transfert
     direct vers un nouvel appareil (câble ou réseau local) reste possible. Android 11 et moins :
     allowBackup="false" dans le manifeste. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" path="." />
        <exclude domain="file" path="." />
        <exclude domain="database" path="." />
        <exclude domain="sharedpref" path="." />
        <exclude domain="external" path="." />
    </cloud-backup>
    <device-transfer />
</data-extraction-rules>
