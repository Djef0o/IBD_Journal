<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. Les jetons cloud sont chiffrés avec une clé du Keystore, qui ne suit pas
     la sauvegarde : restaurés sur un autre téléphone, ils seraient illisibles. On les exclut,
     l'utilisateur reconnecte simplement ses comptes. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cloud_backup.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cloud_backup.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
