<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+. L'état de connexion cloud dépend de l'autorisation Google accordée sur cet
     appareil : restauré ailleurs, il serait trompeur. On l'exclut, l'utilisateur reconnecte
     simplement son compte. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="datastore/cloud_backup.preferences_pb" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="datastore/cloud_backup.preferences_pb" />
    </device-transfer>
</data-extraction-rules>
